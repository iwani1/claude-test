{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "import:legacy": "tsx scripts/import-restpos.ts",
    "setup:bar-stock": "tsx scripts/setup-bar-stock.ts",
    "audit:responsive": "python3 scripts/audit-responsive.py",
    "test:legacy-import": "tsx tests/legacy-import.ts",
    "test:security": "tsx tests/run-security.ts",
    "test": "npm run test:security",
    "db:bootstrap": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.53.0",
    "next": "^16.4.0",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.5.29",
    "tailwindcss": "4.1.17",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
