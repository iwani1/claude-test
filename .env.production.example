# Copy to .env (never commit it). PostgreSQL only. URL-encode password characters.
# Use a dedicated NOSUPERUSER NOBYPASSRLS runtime login with no schema ownership.
DATABASE_URL=postgresql://pos_runtime:REPLACE_PASSWORD@DB_HOST:5432/pos
# Generate locally: openssl rand -hex 48. Do not reuse an example value.
AUTH_SECRET=
NODE_ENV=production
PORT=3000
APP_ORIGIN=https://pos.example.com
# Leave blank: anonymous PIN login is disabled; password login + scoped PIN switch work.
# To opt in for a dedicated single-branch terminal deployment, set its numeric branch ID.
PIN_LOGIN_BRANCH_ID=
# MIGRATION_DATABASE_URL is supplied only to maintenance commands, NOT the web service.
