# /etc/pos/backup.env — settings for scripts/backup.sh and scripts/restore-check.sh.
# Owned by root, mode 0600: it can hold a heartbeat URL. It holds NO secret keys:
# the age setting below is a PUBLIC key, and rclone keeps its own credentials
# in /root/.config/rclone/rclone.conf.

POS_DB=pos
BACKUP_DIR=/var/backups/pos
KEEP_DAYS=14
KEEP_MONTHS=12

# --- Off-site copy (strongly recommended) ------------------------------------
# Public key from `age-keygen -o pos-backup.key` run on YOUR OWN computer.
# Keep pos-backup.key (the private key) OFF this server: it is the only way to
# decrypt the backups, and the server never needs it.
BACKUP_AGE_RECIPIENT=
# rclone remote and bucket/folder, e.g. contabo:pos-backups (set up with `rclone config`).
# Uploads are refused unless BACKUP_AGE_RECIPIENT is set: only encrypted copies leave the server.
BACKUP_REMOTE=
REMOTE_KEEP_DAYS=30

# --- Alerts ------------------------------------------------------------------
# A check URL from healthchecks.io (or similar). A missed or failed run alerts you.
BACKUP_HEARTBEAT_URL=
RESTORE_HEARTBEAT_URL=
