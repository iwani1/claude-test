# /etc/pos/monitor.env — settings for scripts/monitor.sh. Root-only (chmod 600).

# The public name of the till (checks its HTTPS certificate). Leave empty to skip.
CERT_HOST=pos.example.com

# A healthchecks.io (or similar) check URL: period 10 minutes, grace 20 minutes.
# All good pings it; a problem pings /fail with what is wrong; silence alerts too.
MONITOR_HEARTBEAT_URL=

# Thresholds (defaults shown).
# DISK_WARN_PERCENT=85
# CERT_WARN_DAYS=14
# BACKUP_MAX_AGE_HOURS=26
# ERROR_LIMIT=20
# ERROR_WINDOW="10 min ago"
# POS_URL=http://127.0.0.1:3000
# POS_SERVICE=pos
# BACKUP_DIR=/var/backups/pos
